# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml (locally) or paste into the Streamlit Community Cloud
# "Secrets" settings panel. Do NOT commit the real secrets.toml file to GitHub.

# Optional: Hugging Face access token (increases rate limits for downloading model weights)
# HF_TOKEN = "hf_your_personal_access_token_here"

# Optional: ESP32 REST API gateway URL (defaults to http://192.168.12.16 if not set)
# ESP32_BASE_URL = "http://192.168.12.16"

